# ================================================================
# FlexDesk Production Environment Variables
# ================================================================
# Configure these in Railway dashboard - NEVER commit actual values
# For Vercel frontends, set via Vercel dashboard
# ================================================================

# === DATABASE ===

# REQUIRED - PostgreSQL connection string
# Append ?connection_limit=10&pool_timeout=30 for pooled connections (Neon/Railway)
DATABASE_URL=postgresql://user:pass@host:5432/flexdesk?schema=public&connection_limit=10&pool_timeout=30

# OPTIONAL - Direct connection URL for migrations (bypasses connection pooler)
# Required for Neon serverless; optional for Railway PostgreSQL
DIRECT_URL=postgresql://user:pass@host:5432/flexdesk?schema=public

# === AUTHENTICATION ===

# REQUIRED - JWT signing secrets (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m

# REQUIRED - Token secrets for job tracking and customer portal links
JOB_TOKEN_SECRET=
CUSTOMER_PORTAL_SECRET=

# === SERVER ===

# REQUIRED
PORT=3001
NODE_ENV=production

# REQUIRED - CORS origins (comma-separated Vercel production URLs)
CORS_ORIGIN=https://your-admin-app.vercel.app,https://your-website.vercel.app

# REQUIRED - Frontend URLs for redirects and email links
FRONTEND_URL=https://your-admin-app.vercel.app
PUBLIC_APP_URL=https://your-admin-app.vercel.app

# OPTIONAL - Enable Swagger docs (disabled by default in production)
ENABLE_SWAGGER=false

# === BILLING ===

# REQUIRED - Default billing values
DEFAULT_JOB_HOURLY_RATE=100
DEFAULT_TAX_RATE=0.1
DEFAULT_INVOICE_DUE_DATE_DAYS=30

# === STRIPE (OPTIONAL) ===

# OPTIONAL - Payment processing (server starts without these)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === GOOGLE OAUTH (OPTIONAL) ===

# OPTIONAL - Google OAuth login
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-app.up.railway.app/api/v1/auth/google/callback

# === EMAIL - SENDGRID (OPTIONAL) ===

# OPTIONAL - Email notifications (server starts without these)
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@flexdesk.com
SENDGRID_FROM_NAME=FlexDesk

# === SMS - TWILIO (OPTIONAL) ===

# OPTIONAL - SMS notifications (server starts without these)
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# === GOOGLE MAPS (OPTIONAL) ===

# OPTIONAL - Geocoding and distance calculations
GOOGLE_MAPS_API_KEY=AIzaxxx

# === ERROR TRACKING (OPTIONAL) ===

# OPTIONAL - Sentry error tracking (skip if not set)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ================================================================
# VERCEL FRONTEND ENV VARS (set in Vercel dashboard per project)
# ================================================================

# flexdesk-preview-v2:
#   VITE_API_URL=https://your-app.up.railway.app/api/v1    # REQUIRED
#   VITE_APP_NAME=FlexDesk                                                 # OPTIONAL

# flexdesk-website:
#   NEXT_PUBLIC_API_URL=https://your-app.up.railway.app     # REQUIRED
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx                         # OPTIONAL
