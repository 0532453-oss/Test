# ===========================================
# FlexDesk Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL="postgresql://flexdesk:flexdesk_dev_password@localhost:5432/flexdesk?schema=public"

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Public URLs
PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# External Services (Optional for Development)
# ===========================================

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@flexdesk.com
SENDGRID_FROM_NAME=FlexDesk

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google OAuth (for Sign in with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ===========================================
# Frontend Environment Variables
# ===========================================

# Admin/Preview Apps
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Website (Optional)
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_API_KEY=your-algolia-api-key
