{
  "name": "flexdesk-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable UI component library for FlexDesk",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./primitives": {
      "import": "./src/primitives/index.ts",
      "types": "./src/primitives/index.ts"
    },
    "./patterns": {
      "import": "./src/patterns/index.ts",
      "types": "./src/patterns/index.ts"
    },
    "./domain": {
      "import": "./src/domain/index.ts",
      "types": "./src/domain/index.ts"
    },
    "./layouts": {
      "import": "./src/layouts/index.ts",
      "types": "./src/layouts/index.ts"
    },
    "./calendar": {
      "import": "./src/calendar/index.ts",
      "types": "./src/calendar/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@schedule-x/calendar": "^4.1.0",
    "@schedule-x/current-time": "^4.1.0",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/event-modal": "^4.1.0",
    "@schedule-x/events-service": "^4.1.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/resize": "^3.7.3",
    "@schedule-x/theme-default": "^4.1.0",
    "@service-flex/types": "workspace:*",
    "temporal-polyfill": "^0.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.3",
    "jsdom": "^28.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
