{
  "name": "flexdesk-preview",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/simple-jobber-preview/src",
  "projectType": "application",
  "tags": ["scope:preview", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite",
        "cwd": "packages/simple-jobber-preview"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc && vite build",
        "cwd": "packages/simple-jobber-preview"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "packages/simple-jobber-preview"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src --ext .ts,.tsx",
        "cwd": "packages/simple-jobber-preview"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/simple-jobber-preview"
      }
    }
  }
}
