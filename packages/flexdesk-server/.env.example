# =============================================================================
# FlexDesk Server — Environment Variables
# Copy this to .env and fill in actual values. Never commit .env to Git.
# =============================================================================

# Database
# For production with Neon/Railway, append pooling params: ?connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://user:password@localhost:5432/flexdesk?schema=public"
# Direct connection URL for migrations (bypasses connection pooler). Required for Neon; optional otherwise.
DIRECT_URL=

# Server
PORT=3001
NODE_ENV=development

# JWT Authentication (REQUIRED — server will not start without these)
JWT_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=15m

# Token Secrets (REQUIRED — server will not start without these)
JOB_TOKEN_SECRET=generate-a-strong-random-secret
CUSTOMER_PORTAL_SECRET=generate-a-strong-random-secret

# Frontend URLs
FRONTEND_URL=http://localhost:5175
PUBLIC_APP_URL=http://localhost:5175

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5175

# Billing Defaults
DEFAULT_JOB_HOURLY_RATE=100
DEFAULT_TAX_RATE=0.1
DEFAULT_INVOICE_DUE_DATE_DAYS=30

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payment Integration (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid Email (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flexdesk.com
SENDGRID_FROM_NAME=FlexDesk

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=

# Sentry Error Tracking (optional — skip if not set)
SENTRY_DSN=
