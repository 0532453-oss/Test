# =============================================================================
# FlexDesk Server — Production Environment Variables
# Copy this to .env and fill in actual values. Never commit .env to Git.
# =============================================================================

# Database (REQUIRED)
# Append ?connection_limit=10&pool_timeout=30 for pooled connections (Railway/Neon)
DATABASE_URL="postgresql://user:password@host:5432/flexdesk?schema=public&connection_limit=10&pool_timeout=30"
# OPTIONAL - Direct connection URL for migrations (bypasses connection pooler). Required for Neon.
DIRECT_URL="postgresql://user:password@host:5432/flexdesk?schema=public"

# Server (REQUIRED)
PORT=3001
NODE_ENV=production

# JWT Authentication (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m

# Token Secrets (REQUIRED — generate with: openssl rand -hex 32)
JOB_TOKEN_SECRET=
CUSTOMER_PORTAL_SECRET=

# Frontend URLs (REQUIRED)
FRONTEND_URL=https://your-app.vercel.app
PUBLIC_APP_URL=https://your-app.vercel.app

# CORS Origins (REQUIRED in production — comma-separated)
CORS_ORIGIN=https://your-app.vercel.app

# OPTIONAL - Enable Swagger docs (disabled by default in production)
ENABLE_SWAGGER=false

# Billing Defaults (REQUIRED)
DEFAULT_JOB_HOURLY_RATE=100
DEFAULT_TAX_RATE=0.1
DEFAULT_INVOICE_DUE_DATE_DAYS=30

# Google OAuth (OPTIONAL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-api.railway.app/api/v1/auth/google/callback

# Stripe Payment Integration (OPTIONAL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid Email (OPTIONAL)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flexdesk.com
SENDGRID_FROM_NAME=FlexDesk

# Twilio SMS (OPTIONAL)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Maps (OPTIONAL)
GOOGLE_MAPS_API_KEY=

# Sentry Error Tracking (OPTIONAL)
SENTRY_DSN=
