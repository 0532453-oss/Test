{
  "name": "flexdesk",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "nx run flexdesk-server:start:dev",
    "dev:admin": "nx run flexdesk-admin:dev",
    "dev:website": "nx run flexdesk-website:dev",
    "dev:portal": "nx run flexdesk-portal:dev",
    "dev:v2": "pnpm --filter @flexdesk/preview-v2 dev",
    "build": "nx run-many --target=build --all",
    "build:server": "nx run flexdesk-server:build",
    "build:admin": "nx run flexdesk-admin:build",
    "build:preview-v2": "nx run flexdesk-preview-v2:build",
    "build:website": "nx run flexdesk-website:build",
    "build:libs": "nx run-many --target=build --projects=flexdesk-shared,flexdesk-ui,flexdesk-utils",
    "db:generate": "pnpm --filter flexdesk-server exec prisma generate",
    "db:migrate:dev": "pnpm --filter flexdesk-server exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter flexdesk-server exec prisma migrate deploy",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "clean": "nx reset && rimraf node_modules packages/*/node_modules packages/*/.next packages/*/dist",
    "graph": "nx graph",
    "validate:deploy": "bash scripts/validate-deploy.sh"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "nx": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.18",
      "@types/react-dom": "^18.3.5"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.3",
    "@mui/material": "^7.3.7",
    "@radix-ui/react-tabs": "^1.1.13"
  }
}
